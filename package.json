{
  "name": "wordbridge",
  "version": "1.0.0",
  "description": "2-8 player real-time word game — bridge from start letter to end letter",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:server": "node --test tests/server*.test.js",
    "test:ui": "node tests/ui/game-ui.test.js",
    "test:e2e": "node tests/e2e/multiplayer.test.js",
    "test": "npm run test:server && npm run test:ui && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/npangarang/word_bridge"
  },
  "keywords": [
    "word-game",
    "multiplayer",
    "real-time",
    "socketio",
    "express"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "obscenity": "^0.4.6",
    "socket.io": "^4.7.2"
  }
}
